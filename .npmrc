# Build hosts drop registry connections often enough that a single ECONNRESET
# during npm install fails the whole deploy. npm's default is 2 retries with a
# 10s ceiling, which is not enough on a cold builder pulling large native
# packages (sharp, open3d wheels, the three/Spark tree).
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
